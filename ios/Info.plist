<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 手写 Info.plist（project.yml 里 GENERATE_INFOPLIST_FILE=NO）。
	     $(...) 由 Xcode 在构建时替换。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>Vantaloom</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- SwiftUI 无 storyboard 启动：空字典即可拿到全屏（否则 iPhone 上会被信箱化）。 -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- 操控端节点是进程级单例，多窗口 = 多个 WebView 共用同一份回环代理与目标机器；
		     iPad 多窗口留到验证过之后再开。 -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>

	<!-- ATS：WKWebView 只连 http://127.0.0.1:<port>（回环，页面与 API 同源）；
	     Hub 走 https。按社区实测，字面 IP 回环本来就不受 ATS 约束（用 "localhost"
	     主机名才需要例外），但 NSAllowsLocalNetworking 是官方口径、且覆盖预览
	     iframe 里的局域网 http 文档（设计预览/开发服务器），显式打开。
	     绝不开 NSAllowsArbitraryLoads。loomnet 的 QUIC/UDP 与 mTLS 走 Go 自己的
	     网络栈，不经 URLSession，与 ATS 无关。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- 「本地网络」权限说明（iOS 14+）：操控端节点向同一局域网内的电脑发起 QUIC/UDP
	     直连（局域网直连是优先级最高的连接方式），第一次发包时系统会弹这个授权框；
	     缺了这条 iOS 会直接丢弃流量而不弹窗，表现为局域网直连恒超时、只剩中继。
	     回环不触发它；Hub（公网 https）不触发它。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vantaloom 需要访问本地网络，以便通过局域网直接连接到同一账号下的电脑（速度最快、不经服务器）。拒绝后仍可经公网直连或服务器中继连接。</string>

	<!-- TestFlight 上传时免答出口合规问卷。诚实边界：loomnet 用的是 mTLS + QUIC
	     （Go 标准库 crypto/tls），属「标准加密协议」豁免类别；上架前按 App Store
	     Connect 的问卷口径复核这一项。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ── 刻意没开的东西 ──
	     UIBackgroundModes：操控端切后台约 30 秒后挂起，QUIC 会话与信令 WS 一起冻结；
	     回前台由 ControllerHost 调节点 Resume 重连并显示状态卡。操控端没有「必须在
	     后台继续跑」的工作（agent 在电脑上跑），借口式后台模式（audio/location/voip）
	     会被审核打回，也没有必要。 -->
</dict>
</plist>
